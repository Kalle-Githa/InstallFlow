
@contentType = application/json

### Logga in som admin — KÖR DESSA TVÅ FÖRST
# @name login
POST {{host}}/api/auth
Content-Type: {{contentType}}

{
  "userName": "{{adminUserName}}",
  "password": "{{adminPassword}}"
}

### Skapa kund så vi har en customerId
# @name createCustomer
POST {{host}}/api/customers
Content-Type: {{contentType}}
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "company": "Assignment Test AB",
  "person": "Cecilia Cederberg",
  "email": "cecilia@test.se",
  "phone": "0700000000",
  "organizationNumber": "000000-0000"
}

### Hämta alla uppdrag
GET {{host}}/api/assignments
Authorization: Bearer {{login.response.body.$.accessToken}}

### Skapa uppdrag → 201
# @name createAssignment
POST {{host}}/api/assignments
Content-Type: {{contentType}}
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerId": {{createCustomer.response.body.$.id}},
  "name": "Admin-uppdrag våning 2",
  "description": "Ny fiberinstallation",
  "address": "Storgatan 1, Stockholm"
}

### Hämta uppdrag på id
GET {{host}}/api/assignments/{{createAssignment.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Uppdatera uppdrag → 200
PATCH {{host}}/api/assignments/{{createAssignment.response.body.$.id}}
Content-Type: {{contentType}}
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Admin-uppdrag våning 3",
  "status": "InProgress"
}

### Negativtest — Name saknas → 400
POST {{host}}/api/assignments
Content-Type: {{contentType}}
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerId": {{createCustomer.response.body.$.id}}
}

### Negativtest — CustomerId saknas → 400
POST {{host}}/api/assignments
Content-Type: {{contentType}}
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Uppdrag utan kund"
}

### Negativtest — utan token → 401
GET {{host}}/api/assignments

### Radera uppdrag → 204
DELETE {{host}}/api/assignments/{{createAssignment.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
